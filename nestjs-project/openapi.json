          "height",
          "video_codec",
          "audio_codec",
          "container",
          "bitrate"
        ]
      },
      "UploadPlanDto": {
        "type": "object",
        "properties": {
          "part_size": {
            "type": "number",
            "example": 16777216
          },
          "part_count": {
            "type": "number",
            "example": 4
          }
        },
        "required": [
          "part_size",
          "part_count"
        ]
