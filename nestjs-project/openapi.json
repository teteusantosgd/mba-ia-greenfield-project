              {
                "$ref": "#/components/schemas/VideoStatus"
              }
            ]
          },
          "original_filename": {
            "type": "string",
            "example": "aula.mp4"
          },
          "content_type": {
            "type": "string",
            "example": "video/mp4"
          },
          "size_bytes": {
            "type": "number",
            "example": 52428800
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true,
            "example": 312.4
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "failure_reason": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadPlanDto"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "original_filename",
          "content_type",
          "size_bytes",
          "duration_seconds",
          "metadata",
          "failure_reason",
          "created_at",
          "upload"
        ]
      },
      "RequestPartUrlsDto": {
        "type": "object",
        "properties": {
          "part_numbers": {
