            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "new_password"
        ]
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "Original file name, kept for the download.",
            "minLength": 1,
            "maxLength": 255
          },
          "size_bytes": {
            "type": "number",
            "minimum": 1,
            "maximum": 10737418240
          },
          "content_type": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/webm"
            ]
          },
          "title": {
            "type": "string",
            "description": "Defaults to the file name without its extension.",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "filename",
          "size_bytes",
          "content_type"
        ]
