    "/videos/{id}/stream": {
      "get": {
        "description": "The storage answers Range requests with 206, so players can seek.",
        "operationId": "VideosController_stream",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to a signed storage URL, valid for 2 hours",
